# --- OS / Editor ---
.DS_Store
Thumbs.db
*.swp
*~

# --- Cursor / Continue (local tool state) ---
.cursor/*.json
.continue/*.log

# --- Arduino / ESP32 build artifacts ---
build/
build_*/
*.bin
*.bin.sha256
*.elf
*.map
*.hex
ota_release_*/

# Compiler cache created inside the project by arduino-cli/IDE
# root-anchored on purpose: an unanchored "libraries/" also matched ci/libraries
/libraries/

# --- Compiled objects / libraries ---
*.o
*.obj
*.lo
*.a
*.lib
*.so
*.dylib
*.dll
*.gcno
*.gcda
*.pdb
*.ilk
*.d

# --- Precompiled / generated headers ---
*.gch
*.pch

# --- Logs / temp ---
*.log
*.tmp
.env

# --- Python (tooling) ---
__pycache__/
*.pyc
.venv/
venv/
# arduino-cli: build cache/export leftovers at sketch root
esp32.*/

# --- Hardware (PCB) local artifacts ---
hardware/backups/
hardware/kicad/*.kicad_prl
hardware/kicad/*.lck

# --- Локальные черновики/бэкапы трассировки (не версионируются) ---
_work/

# --- Временные файлы превью/скриптов (локально, не версионируются) ---
_work_chrome_profile/
_work_*.py
_work_*.html
_work_*.png
_work_launch.cmd
_work_*.cmd

# --- Отладочные прогоны и данные тестов ---
runs/
*.csv
!hardware/**/*.csv
