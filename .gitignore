# --- OS / Editor ---
.DS_Store
Thumbs.db
*.swp
*~

# --- Cursor / Continue (local tool state) ---
.cursor/*.json
.continue/*.log

# --- Arduino / ESP32 build artifacts ---
build/
build_*/
*.bin
*.bin.sha256
*.elf
*.map
*.hex
ota_release_*/

# Compiler cache created inside the project by arduino-cli/IDE
libraries/

# --- Compiled objects / libraries ---
*.o
*.obj
*.lo
*.a
*.lib
*.so
*.dylib
*.dll
*.gcno
*.gcda
*.pdb
*.ilk
*.d

# --- Precompiled / generated headers ---
*.gch
*.pch

# --- Logs / temp ---
*.log
*.tmp
.env

# --- Python (tooling) ---
__pycache__/
*.pyc
.venv/
venv/
# arduino-cli: build cache/export leftovers at sketch root
esp32.*/
